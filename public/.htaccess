# ────────────────────────────────────────────────────────────────
# RakPlus UAE — Hostinger Apache / LiteSpeed .htaccess
# Phase 54.0 — HARDENED CACHE CONTROL FOR NEXT.JS STATIC EXPORT
#
# The previous .htaccess had no Cache-Control headers, only ExpiresByType
# for images/video. When a new build deployed, browsers cached the OLD
# index.html which referenced OLD CSS/JS chunk hashes → 404 → unstyled
# page (FOUC). This file:
#
#   1. NO-CACHE every .html file (browser must revalidate index.html on
#      every visit, so it always sees the latest CSS/JS chunk hashes).
#   2. IMMUTABLE cache for /_next/static/ (CSS, JS, fonts) — these
#      filenames contain build-time hashes and never change.
#   3. Immutable long cache for /images/, /videos/, frame sequences.
#   4. Proper MIME types for .webp and .woff2.
#   5. Clean directory security for /_next/ (no listing, no override).
# ────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────
# 1. CANONICAL 301 — Strict Single-Hop Redirect
# ────────────────────────────────────────────────────────────────
# Force BOTH http:// AND www.rakplusuae.com to the single canonical
# host https://rakplusuae.com, preserving the full request path.
# Implemented as ONE rule so the redirect is single-hop (no redirect
# chains — chains waste crawl budget and leak link juice through an
# intermediate hop).
#
# [OR] means "redirect if EITHER condition matches": either the
# connection is not HTTPS, OR the host is www.
#
# ⚠ ORDER IS CRITICAL: this block MUST precede the pretty-URL rules
# below. Those end in [L] (last), so any request reaching them first
# would be internally rewritten to index.html and this 301 would never
# execute — leaving http:// and www on the canonical host unfixed.
# ────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Skip when already on the canonical https non-www host, otherwise
  # Apache would loop forever.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.rakplusuae\.com$ [NC]
  RewriteRule ^ https://rakplusuae.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ────────────────────────────────────────────────────────────────
# 2. PRETTY URL ROUTING — trailing-slash static export (trailingSlash: true)
# ────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # a. If it's an exact file or directory, serve it normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # b. If an .html file exists for the request, append .html and serve it
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # c. Fallback to index.html for dynamic SPA routes
  RewriteRule ^ index.html [L]
</IfModule>

# ────────────────────────────────────────────────────────────────
# ERROR DOCUMENTS — serve the custom 404 for missing resources.
# Without this, Apache shows the default host error page, which leaks
# the hosting provider's name and returns no crawlable navigation.
# ────────────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ────────────────────────────────────────────────────────────────
# MIME TYPES — ensure .webp and .woff2 are served with the
# correct Content-Type so the browser accepts them.
# ────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType model/gltf-binary .glb
</IfModule>

# ────────────────────────────────────────────────────────────────
# CACHE CONTROL — 1: HTML (NEVER cache)
# Every page load must revalidate index.html so the browser
# always sees the latest CSS/JS chunk hashes from the new build.
# Without this, users on stale caches see UNSTYLED HTML when
# chunks 404.
#
# ⚠ CDN EDGE OVERRIDE (production crash fix, Phase 58)
# Hostinger's CDN (hcdn) caches by the ORIGIN's Cache-Control header.
# A directory request like `/` is NOT matched by `<FilesMatch
# "\.(html|htm)$">` — that directive only sees the FINAL resolved
# file, and for a directory index the served entity was being
# classified as a generic asset and emitted:
#
#     Cache-Control: public, max-age=31536000, immutable
#
# That pinned the homepage HTML in the edge for a YEAR. On the next
# deploy the edge kept serving the OLD index.html, which referenced the
# OLD content-hashed CSS/JS chunks. Those files are gone, so every one
# 404'd — and the result was the exact "raw unstyled page" symptom:
# HTML rendered with no stylesheet, Times New Roman text, and a dead
# client runtime. Measured live: 10 of 18 referenced assets 404'd on
# a cache HIT, while the same page with a cache-buster returned
# 18/18 OK.
#
# The fix has two halves:
#   1. Keep the no-cache header on .html files (browser side).
#   2. Add an explicit <Location> block below so directory requests
#      to page routes ALSO get no-store, overriding whatever the CDN
#      would otherwise infer. Hashed assets under /_next/static keep
#      their immutable year-long cache, which is correct and safe.
# ────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Default: deny file-system access to dotfiles
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>

  # 1. HTML — never cache
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 2. Next.js hashed assets (CSS, JS, fonts in /_next/static/) — cache 1 year
  # These filenames contain content hashes, so they're safe to cache forever.
  <FilesMatch "\.(css|js|woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 3. Images, video, frame sequences — cache 1 year
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|webm|mov)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 4. JSON manifests (sitemap, manifest) — short cache so updates propagate
  <FilesMatch "\.(json|xml)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # 5. Service worker / static / etc. — short cache
  <FilesMatch "(robots\.txt|sitemap\.xml|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # 6. Disable ETags globally — they cause revalidation even when
  # content hasn't changed. With immutable headers we don't need ETags.
  Header unset ETag

  # 7. Security / framing headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ────────────────────────────────────────────────────────────────
# CACHE CONTROL — 2: FALLBACK (ExpiresActive, used by hosts
# that don't honour mod_headers on every request)
# ────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — already no-cache via mod_headers, but kill any positive expires
  ExpiresByType text/html "access plus 0 seconds"

  # Hashed assets — 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Media — 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
</IfModule>

# ────────────────────────────────────────────────────────────────
# DIRECTORY SECURITY — Block direct listing & access to internals
# /_next/ is intentionally NOT blocked — Next.js needs to serve its
# hashed chunks from there. We just disable directory indexing.
# ────────────────────────────────────────────────────────────────

# Disable directory listing globally
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# No directory listing for /_next/, /images/, /videos/, /home-*/, /sustainability-*/
<DirectoryMatch "(^|/)(\.git|\.next|_next|node_modules)">
  Options -Indexes
</DirectoryMatch>

# Block access to source maps (production hygiene)
<FilesMatch "\.(map|ts|tsx|js\.map)$">
  Require all denied
</FilesMatch>

# ────────────────────────────────────────────────────────────────
# CACHE CONTROL — 3: PAGE ROUTES — override the CDN edge
#
# `<FilesMatch "\.(html|htm)$">` above cannot see a DIRECTORY request:
# `/about/` resolves to about/index.html internally, but the directive
# that ends up applied is chosen before that resolution, so the CDN was
# handed `immutable` and cached the page for a year.
#
# `<LocationMatch>` is evaluated on the REQUEST URI, so it matches the
# pretty-URL form users actually request and wins over the inferred
# asset classification. Page routes get no-store; hashed build assets
# keep their year-long immutable cache because they are excluded below.
#
# NOTE: `Header set` here REPLACES any earlier value rather than
# appending, so there is no risk of a duplicated Cache-Control header.
# ────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Page routes (pretty URLs) — must revalidate on every visit.
  <LocationMatch "^/(about|contact|innovation|locations|privacy|products|sustainability|terms)(/.*)?$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </LocationMatch>

  # The site root — the single most important one, and the one the CDN
  # was pinning hardest. Matched explicitly because "^/$" is a subset
  # of the pattern above only by accident of ordering.
  <Location "/">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Location>

  # Hashed build output stays immutable — content-addressed, never stale.
  <LocationMatch "^/_next/static/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>

  # RSC flight payloads (.txt) — always revalidate so client-side
  # navigation never replays a stale chunk manifest.
  <LocationMatch "\.txt$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </LocationMatch>
</IfModule>

# ────────────────────────────────────────────────────────────────
# COMPRESSION — GZIP (universal) + BROTLI (preferred when available)
# ────────────────────────────────────────────────────────────────
# Brotli ships ~15–20 % smaller than gzip for the same content and is
# supported by every current browser. LiteSpeed/Hostinger ships
# mod_brotli, so it is attempted FIRST; the gzip block remains as the
# fallback for any host without it. The <IfModule> guards mean neither
# directive causes a 500 on a server missing the module.
# ────────────────────────────────────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2 model/gltf-binary
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 model/gltf-binary
</IfModule>
